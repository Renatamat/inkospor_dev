<div class="headerMenu d-lg-none" id="mobileMenu" aria-hidden="true">
  <div class="container">
    <div class="row rowMobileMenu">
      <div class="col-12">
        <div class="mobileLogoMenu d-flex w-100 justify-content-between align-items-center">
          <a href="#" title="Inkospor Home" aria-label="Inkospor Home">
            <img src="{{logoHeader}}" alt="logo Inkospor">
          </a>

          <button class="c-btn c-btn-text c-btn-icon c-btn-icon-xl" id="closeMobileMenu" type="button" aria-label="Zamknij menu">
            <svg class="i-sprite icon-24" aria-hidden="true" focusable="false">
              <use href="/sprites/icons-24.svg#close"></use>
            </svg>
          </button>
        </div>
      </div>
    </div>

    <div class="row rowMenuContent">
      <div class="col-12">
        <nav class="headerMenuNav" aria-label="Mobilna nawigacja">
          <ul class="d-flex flex-column gap-0 m-0 p-0 list-unstyled">
            <li class="menu-item">
              <a href="#" class="c-btn c-btn-s c-btn-text --nav fw-bold justify-content-start w-100">
                <span>PRODUKTY</span>
              </a>
            </li>

            <li class="menu-item">
              <a href="#" class="c-btn c-btn-s c-btn-text --nav fw-bold c-red justify-content-start w-100">
                <span>% PROMOCJE</span>
              </a>
            </li>

            <li class="menu-item has-submenu info-item">
              <button class="blog-accordeon c-btn c-btn-s c-btn-text --nav fw-bold justify-content-between w-100"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#mobile-info-categories"
                aria-expanded="false"
                aria-controls="mobile-info-categories">
                <span>PRZYDATNE INFORMACJE</span>
                <span class="c-filter-section__icon c-collapse-icon">
                  <span class="icon-minus">
                    <svg class="i-sprite icon-16" aria-hidden="true" focusable="false">
                      <use href="/sprites/icons-16.svg#chevron_up_2"></use>
                    </svg>
                  </span>
                  <span class="icon-plus">
                    <svg class="i-sprite icon-16" aria-hidden="true" focusable="false">
                      <use href="/sprites/icons-16.svg#chevron_down_2"></use>
                    </svg>
                  </span>
                </span>
              </button>

              <div class="wrapper-subnav">
                <ul class="subnav collapse" id="mobile-info-categories">
                  <li class="subnav-item">
                    <a href="#" class="p-s fw-bold link-lvl2">Wszystkie kategorie</a>
                  </li>
                  <li class="subnav-item">
                    <a href="#" class="p-s fw-bold link-lvl2">Odchudzanie i kontrola wagi</a>
                  </li>
                  <li class="subnav-item">
                    <a href="#" class="p-s fw-bold link-lvl2">Zdrowie i dobre samopoczucie</a>
                  </li>
                  <li class="subnav-item">
                    <a href="#" class="p-s fw-bold link-lvl2">Dieta i ciekawe przepisy</a>
                  </li>
                </ul>
              </div>
            </li>
          </ul>
        </nav>

        <div class="headerMenuActions d-flex flex-column gap-8 pt-24">
          <a href="#" class="c-btn c-btn-s c-btn-text fw-bold justify-content-start">
            <svg class="i-sprite icon-24 flex-shrink-0" aria-hidden="true" focusable="false">
              <use href="/sprites/icons-24.svg#user"></use>
            </svg>
            <span>Moje konto</span>
          </a>

          <a href="#" class="cart-toggle c-btn c-btn-s c-btn-text fw-bold justify-content-start" aria-controls="cartDrawer" aria-expanded="false">
            <div class="position-relative d-inline-flex pr-8">
              <svg class="i-sprite icon-24 flex-shrink-0" aria-hidden="true" focusable="false">
                <use href="/sprites/icons-24.svg#cart"></use>
              </svg>
              <span class="cart-toggle-count js-cart-count text-decoration-none">6</span>
            </div>
            <span>1 690,00 zł</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>
