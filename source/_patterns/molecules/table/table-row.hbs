<tr>
  {{#cells}}
    <td class="c-table__cell c-table__cell--{{key}} p-s d-flex d-md-table-cell gap-16 {{#if align_center}}text-center{{/if}} {{#if align_end}}text-md-end{{/if}}">
      <span class="c-table__label d-md-none fw-bold text-start">{{label}}</span>
      <span class="c-table__value">
        {{#if is_change}}
          <span class="d-flex align-items-center  justify-content-end justify-content-md-between gap-8">
            <span>{{value}}</span>
            {{#if change}}
              <svg class="i-sprite icon-16 c-table__change c-table__change--{{change}}" aria-hidden="true" focusable="false">
                <use href="/sprites/icons-16.svg#arrow_{{change}}"></use>
              </svg>
            {{/if}}
          </span>
        {{else}}
          {{#if is_status}}
            <span class="c-table__status c-table__status--{{status}} d-inline-flex align-items-center justify-content-center">
              <svg class="i-sprite icon-16" aria-hidden="true" focusable="false">
                <use href="/sprites/icons-16.svg#{{icon}}"></use>
              </svg>
              <span class="visually-hidden">{{value}}</span>
            </span>
          {{else}}
            {{#if is_action}}
              <a class="c-btn c-btn-xs c-btn-text fw-bold" href="{{url}}">
                <span>{{value}}</span>
                <svg class="i-sprite icon-16" aria-hidden="true" focusable="false">
                  <use href="/sprites/icons-16.svg#chevron_right_2"></use>
                </svg>
              </a>
            {{else}}
              {{#if is_link}}
                <a class="fw-bold text-decoration-underline text-reset" href="{{url}}">{{value}}</a>
              {{else}}
                <span>{{value}}</span>
              {{/if}}
            {{/if}}
          {{/if}}
        {{/if}}
      </span>
    </td>
  {{/cells}}
</tr>
