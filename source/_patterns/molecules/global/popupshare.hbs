<div class="popup-share-bg" data-product-share-popup aria-hidden="true">
    <div class="popup-share-container" role="dialog" aria-modal="true" aria-labelledby="product-share-title">
        <div class="d-flex flex-column gap-32">
            <div class="d-flex justify-content-between">
                <div></div>
                <span class="p-m">Udost&#281;pnij produkt</span>
