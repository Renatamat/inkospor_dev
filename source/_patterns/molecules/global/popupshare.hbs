                        <use href="/sprites/icons-24.svg#close"></use>
                    </svg>
                </button>
            </div>
            <span class="h6 fw-bolder text-center" id="product-share-title" data-product-share-title>POMPKA (CZARNA) DO KONCENTRAT&#211;W</span>
            <div class="d-flex flex-column gap-16 align-items-center">
