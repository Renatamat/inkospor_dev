                <div class="d-flex gap-24 justify-content-center">
                    <a class="c-btn c-btn-fill c-btn-icon c-btn-icon-xl" data-product-share-social="facebook" target="_blank" rel="noopener">
                        <svg class="i-sprite icon-24 flex-shrink-0" aria-hidden="true" focusable="false">
                            <use href="/sprites/icons-24.svg#facebook"></use>
