        <div class="c-cart-drawer__summary-total d-flex justify-content-between align-items-center w-100 pt-8">
          <div class="p-m fw-bold">Razem</div>
          <div class="p-m fw-bold">417,00 zł</div>
        </div>
      </div>

      <div class="p-24 bg-white d-flex flex-column align-items-end gap-16">
        <button type="button" class="cart-close c-btn c-btn-m c-btn-outline w-100">
          <span class="px-12">Kontynuuj zakupy</span>
        </button>

        <a href="#" class="c-btn c-btn-m c-btn-fill w-100">
          <span class="px-12">Złóż zamówienie</span>
          <svg class="i-sprite icon-20" aria-hidden="true" focusable="false">
            <use href="/sprites/icons-20.svg#cart"></use>
