                </svg>
              </button>
              <span class="c-qty-switch__value p-m">1</span>
              <button type="button" class="c-qty-switch__btn" aria-label="Zwiększ ilość">
                <svg class="i-sprite icon-16" aria-hidden="true" focusable="false">
                  <use href="/sprites/icons-16.svg#plus_2"></use>
                </svg>
              </button>
            </div>

            <div class="flex-grow-1 d-flex align-items-start gap-8">
              <div class="c-cart-drawer__price p-m fw-bold">119,00 zł</div>
            </div>

            <button type="button" class="c-btn c-btn-text c-btn-icon c-btn-icon-s" aria-label="Usuń produkt">
              <svg class="i-sprite icon-16" aria-hidden="true" focusable="false">
                <use href="/sprites/icons-16.svg#trash"></use>
              </svg>
            </button>
          </div>
        </div>
      </div>

      <div class="c-cart-drawer__item d-flex align-items-start gap-16 px-20 py-12">
        <div class="c-cart-drawer__image-wrap d-flex align-items-center justify-content-center">
