<div class="c-cart-drawer" id="cartDrawer" aria-hidden="true">
  <div class="c-cart-drawer__content d-flex flex-column justify-content-between">
    <div class="c-cart-drawer__header bg-black d-flex justify-content-between align-items-center px-12 py-16 text-white">
