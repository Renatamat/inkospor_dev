        </div>

        <div class="d-flex flex-column flex-grow-1 gap-16 h-100">
          <div class="d-flex flex-column h-100">
            <span class="p-m fw-bold">Inkospor Fitness baton I Kokosowy</span>
            <span class="p-s">60 g / kokosowy</span>
          </div>

          <div class="d-flex flex-wrap align-items-center gap-16">
            <div class="c-qty-switch flex-shrink-0 d-inline-flex align-items-center">
              <button type="button" class="c-qty-switch__btn" aria-label="Zmniejsz ilość">
                <svg class="i-sprite icon-16" aria-hidden="true" focusable="false">
