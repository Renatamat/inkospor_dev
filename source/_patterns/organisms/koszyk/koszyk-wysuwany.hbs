        <svg class="i-sprite icon-16" aria-hidden="true" focusable="false">
          <use href="/sprites/icons-16.svg#close"></use>
        </svg>
      </button>
      <div class="p-m fw-bold justify-content-center"><span>Koszyk</span></div>
      <div class="c-cart-drawer__header-side text-end">
        <span class="p-s">2 produkty</span>
      </div>
    </div>

    <div class="cart-products d-flex flex-column">
      <div class="c-cart-drawer__item d-flex align-items-start gap-16 px-20 py-12">
