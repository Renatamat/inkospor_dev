<section class="hp-prod pt-64 pb-64 pt-lg-128 pb-lg-128">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="d-flex flex-column gap-32 align-items-center hp-prod-top">
                    <img src="{{top10prod}}" alt="" data-prod-top-zoom>
                    <h2 class="h5 fw-bolder text-center">Esencja jakości i skuteczności <br>w suplementacji sportowej.</h2>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-12">
